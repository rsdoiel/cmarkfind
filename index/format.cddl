; cmarkfind index format, version 1 (implemented by cmarkfind; not frozen until it is released)
;
; CDDL (RFC 8610) for the files of one index: a manifest and the files it
; names. The manifest is JSON (RFC 8259) so a person can read it; every other
; file is deterministic CBOR (RFC 8949 section 4.2), compressed as the manifest
; says. A reader needs this file and the paragraphs below, nothing else.
;
; LAYOUT. An index is a directory (or a site folder) holding:
;
;   manifest.json                  the only file with a fixed name
;   w/<digest>.cbor[.gz|.br|.zst]  word chunks   (name = lower-case hex digest)
;   d/<digest>.cbor[.gz|.br|.zst]  document tables
;   f/<digest>.cbor[.gz|.br|.zst]  fragments, one per page
;   x/<digest>.cbor[.gz|.br|.zst]  filter files (reserved; empty in version 1)
;
; Every address in a manifest is a path relative to the manifest, built as
; above from a digest. A reader refuses an absolute address, a scheme, "..",
; or a path that is not one of these forms.
;
; DIGEST. The digest of a file is the SHA-256 of its *uncompressed* bytes, so
; the same index has the same digests whatever compressor wrote it. A reader
; decompresses with a limit (the size in the manifest, never more than
; max-file-size below), then checks the digest, then decodes. The compressed
; bytes are not digested: HTTPS covers transport, the digest guards against
; corruption and swapped or stale files, not against a spoofed site.
;
; VERSION RULE. A version-1 reader (a) ignores unknown trailing elements of an
; array and unknown keys of a map unless the key is in "required" (below);
; (b) refuses a manifest whose "format" or "analyzer" it does not know, whose
; "required" lists a feature it does not know, or whose "generation" is lower
; than the one it already holds for that index; (c) rejects duplicate map keys
; and indefinite-length CBOR items. A change that old readers must not ignore
; is a new "format" (cmarkfind/2).
;
; LIMITS. Readers cap: manifest 4 MiB, one decompressed file "max-file-size",
; array and map sizes in a file at its entry count, nesting depth 8, and the
; number of files a manifest names ("max-files"). The numbers below are the
; defaults of version 1.

max-file-size = 8388608      ; 8 MiB decompressed
max-files = 1000000

; Named key types: a map may hold any further text (or unsigned) keys.
text-key = tstr
uint-key = uint

; ---------------------------------------------------------------- manifest

manifest = {
  format: "cmarkfind/1",
  analyzer: "unicode-word-v3",     ; how words are made (see the tokenizer note)
  generation: uint,                ; grows with every build of the same index
  built: tstr,                     ; RFC 3339 UTC time of the build
  ? required: [* tstr],            ; features a reader must know to use this index
  ? documentOnly: [* tstr],        ; words stored without positions, sorted (see "posting")
  compression: compression,        ; applies to every file unless a file says otherwise
  documents: documents,
  chunks: [+ chunk],               ; sorted, covering every word, no overlap
  ? filters: {* text-key => file},     ; reserved for facets
  ? extensions: {* text-key => any},   ; reverse-domain names; ignored when unknown
  * text-key => any                ; unknown keys are ignored
}

compression = "none" / "gzip" / "br" / "zstd"

; The documents of the index, numbered from 0 in the order of "ranges".
documents = {
  count: uint,
  words: uint,                     ; total of every document's word_count (average length = words / count)
  ranges: [+ [first: uint, last: uint, file]],
  * text-key => any
}

; A word chunk covers the words from "from" to "to" inclusive, in byte order of
; their UTF-8 (the order of Go's string comparison). Chunks are cut by a count
; of entries when the index is built; the count is not part of the format.
chunk = [from: tstr, to: tstr, file]

; A file: digest of the uncompressed bytes (lower-case hex, 64 characters) and
; its uncompressed size in bytes. The path follows from the digest.
file = [digest: tstr .size 64, size: uint .le max-file-size]

; ------------------------------------------------------------- word chunks

; Header [version, analyzer, generation, entries]. A reader rejects a file
; whose three header values differ from the manifest's.
word-chunk = [1, "unicode-word-v3", generation: uint, entries: [* entry]]

entry = [word: tstr, postings: [+ posting]]

; A posting is one document's use of the word.
;   delta     document number minus the previous posting's (the first: the number)
;   locations word positions in the document's word list, each as the difference from the
;             previous one (the first: the position); a negative integer -w is a weight
;             marker: the positions after it have weight w (default weight 1)
;   meta      reserved (version 1 writers omit it): positions inside a named field,
;             [field, delta positions]; written as a second form because a trailing
;             optional array element is not read the same way by every tool
;
; DOCUMENT-ONLY WORDS. A word whose entry would pass about 2 MiB (a quarter of
; max-file-size) is written without positions and listed, sorted, in the
; manifest's "documentOnly"; a manifest that lists any also lists the feature
; "document-only-words/1" in "required", and a reader refuses a list without it.
; The "locations" of a posting of such a word are the weights of the fields it
; occurs in, as a strictly decreasing list of positive integers (4 title, 2
; description, 1 body), not positions. A reader treats each as one use of the
; word in that field at an unknown position: it counts for a term search, a
; field clause and the score. A phrase through such a word is answered by the
; index as a superset (the other words at their offsets, this one in the same
; field anywhere in the page) and settled on the fragment: a reader checks each
; hit's words, in rank order, until it has enough, and NOT of a superset is
; every page and not its complement. A word longer than 128 bytes is not given an entry at
; all, and still counts as a word of the page's list.
posting = [delta: uint, locations: [* int]]
        / [delta: uint, locations: [* int], meta: [* [field: uint, [* uint]]]]

; --------------------------------------------------------- document tables

; One entry per document number of the range, in order: word_count and the
; digest of the document's fragment file (32 bytes, not hex).
document-table = [1, "unicode-word-v3", generation: uint, rows: [* document-row]]
document-row = [word_count: uint, fragment: bstr .size 32]

; --------------------------------------------------------------- fragments

; The text of a page as the tokenizer sees it: one surface word per word of the
; page, joined by single spaces, so the whitespace split of "text" has exactly
; word_count words and a position in a posting indexes one of them. Title,
; description and body words are in that order and "segments" says how many of
; each there are.
fragment = {
  0: tstr,                         ; address: the page's published address
  1: tstr,                         ; text
  2: uint,                         ; word_count
  ? 3: {* text-key => field-value}, ; fields from front matter, as strings
  ? 4: [* anchor],                 ; headings
  ? 5: [* segment],                ; [weight, word count] pieces of "text"
  * uint-key => any
}

field-value = tstr / [* tstr]

; A heading: its slug, its heading text (Markdown syntax removed), the position
; of its first word in "text", its level (1 to 6). The slug rule is the one
; GitHub uses, so a link to a heading resolves on sites that follow it: lower
; case; letters, marks, digits, "-" and "_" kept; each space becomes "-"; other
; characters dropped; a repeat of a slug on the page gets "-1", "-2", ...
; Headings with no word or an empty slug are left out.
anchor = [slug: tstr, heading: tstr, position: uint, level: 1..6]
segment = [weight: uint, words: uint]

; ------------------------------------------------------------ filter files

; Reserved. Version 1 writers emit none and readers ignore "filters".
filter-file = [1, "unicode-word-v3", generation: uint, name: tstr, values: {* text-key => [* uint]}]
